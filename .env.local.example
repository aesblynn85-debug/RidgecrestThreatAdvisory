# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is ONLY used server-side (CAD webhook ingestion). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SearXNG (self-hosted, https://docs.searxng.org) for Live OSINT search - server-only.
# The instance must have JSON output enabled (add "- json" under "search: formats:" in its
# settings.yml) -- most public instances disable this, so point at one you run yourself.
SEARXNG_URL=http://localhost:8080

# Optional: path to the Python 3 interpreter used for the DuckDuckGo fallback search
# (scripts/ddg_search.py, via the duckduckgo-search library -- see requirements.txt).
# Defaults to "python3" on PATH. Only used if SearXNG is unset or a search fails, and only
# works on a host that lets you spawn real processes (not standard Vercel serverless functions).
PYTHON_BIN=python3

# Shared secret the CAD system must send as x-webhook-secret header when pushing records
CAD_WEBHOOK_SECRET=choose-a-long-random-string

# Read-only access to the RidgecrestCAD Supabase project, used by the CAD sync
# (pulls calls/dispatches, reports, and guard_notes into this app's cad_records table)
CAD_SUPABASE_URL=https://your-cad-project-ref.supabase.co
CAD_SUPABASE_ANON_KEY=your-cad-anon-key

# Display name for the app shell / owner label
NEXT_PUBLIC_ORG_NAME="R.A.V.E.N. Intelligence"
