# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is ONLY used server-side (CAD webhook ingestion). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SerpAPI (https://serpapi.com) for Live OSINT search - server-only
SERPAPI_KEY=your-serpapi-key

# Shared secret the CAD system must send as x-webhook-secret header when pushing records
CAD_WEBHOOK_SECRET=choose-a-long-random-string

# Read-only access to the RidgecrestCAD Supabase project, used by the CAD sync
# (pulls calls/dispatches, reports, and guard_notes into this app's cad_records table)
CAD_SUPABASE_URL=https://your-cad-project-ref.supabase.co
CAD_SUPABASE_ANON_KEY=your-cad-anon-key

# Display name for the app shell / owner label
NEXT_PUBLIC_ORG_NAME="Ridgecrest Intelligence"
